# Copy this file to .env.local and fill in the values.
# Also add the same variables in your hosting dashboard (e.g. Vercel > Settings > Environment Variables).

# Required: API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional: where contact messages go (defaults to the email in data/profile.ts)
CONTACT_TO_EMAIL=

# Optional: sender address. Leave empty to use onboarding@resend.dev, which only
# delivers to the email you signed up to Resend with. Once you verify your own
# domain in Resend you can use something like: Portfolio <hello@yourdomain.com>
CONTACT_FROM_EMAIL=
